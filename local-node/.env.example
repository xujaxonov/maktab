# Nusxa oling: .env.example -> .env

# Markaziy server manzili
SERVER_URL=https://smartdavomat.example.uz

# Admin paneli -> Xonalar va kameralar -> Lokal miya -> "Token yaratish"
NODE_TOKEN=

# NVR oqimi andozasi. {channel} o'rniga admin panelida xonaga yozilgan kanal raqami qo'yiladi.
# Login va parol faqat shu faylda saqlanadi, markaziy serverga yuborilmaydi.
# Hikvision:
NVR_URL_TEMPLATE=rtsp://LOGIN:PAROL@192.168.1.64:554/Streaming/Channels/{channel}01
# Dahua:
# NVR_URL_TEMPLATE=rtsp://LOGIN:PAROL@192.168.1.108:554/cam/realmonitor?channel={channel}&subtype=0

# Alohida kanal uchun aniq manzil (ixtiyoriy). Sinov uchun rasm yoki video fayl ham bo'ladi:
# CAMERA_URLS={"3": "rtsp://...", "99": "/app/data/sinf.jpg"}
CAMERA_URLS={}

# Aniqlash sozlamalari
MODEL=yolo11n.pt
CONFIDENCE=0.35
IMAGE_SIZE=960
SAMPLE_INTERVAL=2
MAX_PARALLEL=10
HEARTBEAT_SEC=300

# Nusxa oling: .env.example -> .env va qiymatlarni to'ldiring.

# Server porti
PORT=3000

# Telegram bot tokeni (@BotFather beradi). Bo'sh bo'lsa, bot o'chiq, xabarlar navbatda kutadi.
BOT_TOKEN=

# Bot nomi @ belgisisiz, masalan: smartdavomat_bot (ota-onalar kartochkasida ko'rsatiladi)
BOT_USERNAME=

# Ma'lumotlar bazasi fayli
DB_PATH=data/smartdavomat.db

# HTTPS orqali ishlaganda 1 qiling (cookie faqat HTTPS orqali yuboriladi)
COOKIE_SECURE=0

# Faqat sinov uchun: 1 bo'lsa, darsni istalgan vaqtda boshlash va tahrirlash mumkin. Maktabda 0 bo'lsin!
ALLOW_ANY_TIME=0
